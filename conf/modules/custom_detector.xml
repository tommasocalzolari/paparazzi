<!DOCTYPE module SYSTEM "module.dtd">

<module name="custom_detector" dir="computer_vision">
  <doc>
    <description>
      Pure C color risk detector for YUV422 images.
      Detects orange and green obstacles and computes a 3-column risk map.
      Publishes:
      AbiSendMsgCUSTOM_DETECTION(CUSTOM_DETECT_COLOR_OBJECT_ID, left, middle, right)

      Real detection path does not depend on OpenCV.
      Optional debug drawing modifies the incoming YUV image buffer.
    </description>

    <define name="CUSTOM_COLOR_RISK_DETECTOR_CAMERA" value="front_camera|bottom_camera" description="Video device to use"/>
    <define name="CUSTOM_COLOR_RISK_DETECTOR_FPS" value="0" description="Desired FPS (0: camera rate)"/>
    <define name="CUSTOM_COLOR_RISK_DETECTOR_DEBUG" value="FALSE|TRUE" description="Whether or not to draw debug overlays on image"/>
    <define name="CUSTOM_COLOR_RISK_DETECTOR_VERBOSE" value="0|1" description="Enable verbose debug prints"/>
    <define name="CUSTOM_DETECT_COLOR_OBJECT_ID" value="1" description="ABI message id for risk publication"/>

    <define name="CCRD_MAX_PIXELS" value="(640*480)" description="Maximum supported image size in pixels"/>
    <define name="CCRD_MAX_ORANGE_BANDS" value="512" description="Maximum stored orange vertical band candidates"/>
    <define name="CCRD_MAX_ORANGE_OBJECTS" value="16" description="Maximum stored final orange objects"/>
    <define name="CCRD_MAX_GREEN_COMPONENTS" value="384" description="Maximum stored green connected components"/>
    <define name="CCRD_MAX_GREEN_OBJECTS" value="32" description="Maximum stored final green objects"/>

    <define name="CCRD_ORANGE_Y_MIN" value="70" description="Orange minimum Y"/>
    <define name="CCRD_ORANGE_Y_MAX" value="170" description="Orange maximum Y"/>
    <define name="CCRD_ORANGE_U_MIN" value="87" description="Orange minimum U"/>
    <define name="CCRD_ORANGE_U_MAX" value="121" description="Orange maximum U"/>
    <define name="CCRD_ORANGE_V_MIN" value="155" description="Orange minimum V"/>
    <define name="CCRD_ORANGE_V_MAX" value="210" description="Orange maximum V"/>
    <define name="CCRD_ORANGE_VU_MIN" value="45" description="Orange minimum (V-U)"/>

    <define name="CCRD_GREEN_Y_MIN" value="45" description="Green minimum Y"/>
    <define name="CCRD_GREEN_Y_MAX" value="165" description="Green maximum Y"/>
    <define name="CCRD_GREEN_U_MIN" value="50" description="Green minimum U"/>
    <define name="CCRD_GREEN_U_MAX" value="120" description="Green maximum U"/>
    <define name="CCRD_GREEN_V_MIN" value="105" description="Green minimum V"/>
    <define name="CCRD_GREEN_V_MAX" value="148" description="Green maximum V"/>
    <define name="CCRD_GREEN_VU_MIN" value="20" description="Green minimum (V-U)"/>

    <define name="CCRD_ORANGE_ROI_Y_START_NUM" value="1" description="Orange ROI start numerator"/>
    <define name="CCRD_ORANGE_ROI_Y_START_DEN" value="10" description="Orange ROI start denominator"/>
    <define name="CCRD_ORANGE_ROI_Y_END_NUM" value="1" description="Orange ROI end numerator"/>
    <define name="CCRD_ORANGE_ROI_Y_END_DEN" value="1" description="Orange ROI end denominator"/>

    <define name="CCRD_ORANGE_SCAN_STEP_X" value="8" description="Orange scan horizontal step"/>
    <define name="CCRD_ORANGE_MIN_VERTICAL_RUN" value="10" description="Minimum orange vertical run"/>
    <define name="CCRD_ORANGE_MIN_HITS_IN_COLUMN" value="20" description="Minimum orange hits in band"/>
    <define name="CCRD_ORANGE_BAND_WIDTH" value="8" description="Orange band width"/>
    <define name="CCRD_ORANGE_MAX_GAP_BETWEEN_BANDS" value="20" description="Maximum horizontal gap between grouped orange bands"/>
    <define name="CCRD_ORANGE_MIN_GROUP_WIDTH" value="6" description="Minimum orange grouped width"/>
    <define name="CCRD_ORANGE_MAX_GROUP_WIDTH" value="180" description="Maximum orange grouped width"/>
    <define name="CCRD_ORANGE_MIN_GROUP_HEIGHT" value="35" description="Minimum orange grouped height"/>
    <define name="CCRD_ORANGE_MIN_GROUP_DENSITY_NUM" value="10" description="Orange grouped density numerator"/>
    <define name="CCRD_ORANGE_MIN_GROUP_DENSITY_DEN" value="100" description="Orange grouped density denominator"/>
    <define name="CCRD_ORANGE_MIN_ASPECT_NUM" value="12" description="Orange min aspect numerator"/>
    <define name="CCRD_ORANGE_MIN_ASPECT_DEN" value="10" description="Orange min aspect denominator"/>
    <define name="CCRD_ORANGE_VERTICAL_GAP_TOLERANCE" value="2" description="Orange vertical gap fill tolerance"/>

    <define name="CCRD_GRAD_THRESHOLD" value="18" description="Vertical edge gradient threshold"/>
    <define name="CCRD_GREEN_EDGE_EXPAND_PX" value="6" description="Horizontal edge expansion radius for green support"/>
    <define name="CCRD_GREEN_MIN_SUPPORTED_PIXELS" value="30" description="Minimum supported green seed area"/>
    <define name="CCRD_GREEN_MIN_BOX_AREA" value="400" description="Minimum green final box area"/>
    <define name="CCRD_GREEN_MIN_HEIGHT" value="20" description="Minimum green final box height"/>
    <define name="CCRD_GREEN_MIN_RAW_DENSITY_NUM" value="20" description="Green raw density numerator"/>
    <define name="CCRD_GREEN_MIN_RAW_DENSITY_DEN" value="100" description="Green raw density denominator"/>
    <define name="CCRD_GREEN_BBOX_EXPAND_X" value="40" description="Green bbox expand in X"/>
    <define name="CCRD_GREEN_BBOX_EXPAND_Y" value="10" description="Green bbox expand in Y"/>
    <define name="CCRD_GREEN_ROW_DENSITY_NUM" value="10" description="Green row density numerator"/>
    <define name="CCRD_GREEN_ROW_DENSITY_DEN" value="100" description="Green row density denominator"/>
    <define name="CCRD_GREEN_COL_DENSITY_NUM" value="8" description="Green column density numerator"/>
    <define name="CCRD_GREEN_COL_DENSITY_DEN" value="100" description="Green column density denominator"/>
    <define name="CCRD_GREEN_MIN_SUPPORTED_DENSITY_NUM" value="15" description="Green supported density numerator"/>
    <define name="CCRD_GREEN_MIN_SUPPORTED_DENSITY_DEN" value="1000" description="Green supported density denominator"/>
    <define name="CCRD_GREEN_MIN_ASPECT_NUM" value="45" description="Green minimum aspect numerator"/>
    <define name="CCRD_GREEN_MIN_ASPECT_DEN" value="100" description="Green minimum aspect denominator"/>
    <define name="CCRD_GREEN_MIN_SEED_GREEN_RATIO_NUM" value="8" description="Green minimum seed raw ratio numerator"/>
    <define name="CCRD_GREEN_MIN_SEED_GREEN_RATIO_DEN" value="100" description="Green minimum seed raw ratio denominator"/>

    <define name="CCRD_ORANGE_BOTTOM_ROWS_THRESHOLD_NUM" value="15" description="Orange risk threshold numerator on bottom row"/>
    <define name="CCRD_ORANGE_BOTTOM_ROWS_THRESHOLD_DEN" value="100" description="Orange risk threshold denominator on bottom row"/>
    <define name="CCRD_GREEN_MIDDLE_ROWS_THRESHOLD_NUM" value="10" description="Green risk threshold numerator on middle rows"/>
    <define name="CCRD_GREEN_MIDDLE_ROWS_THRESHOLD_DEN" value="100" description="Green risk threshold denominator on middle rows"/>
  </doc>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
   <!--<file name="custom_detector_fast_rotated.h"/> --> 
   <file name="custom_detector_fast_timer.h"/>
  </header>

  <init fun="custom_color_risk_detector_init()"/>
  <periodic fun="custom_color_risk_detector_periodic()" freq="10"/>

  <makefile target="ap|nps">
   <!-- <file name="custom_detector_fast_rotated.c"/> --> 
   <file name="custom_detector_fast_timer.c"/>
  </makefile>
</module>